# SmartProBonoIP environment variables
# Everything here is OPTIONAL. With no variables set, the app runs end-to-end
# using a local (in-browser) data store and the rule-based profile generator.

# --- Supabase (optional) ---------------------------------------------------
# If BOTH are set, the app persists data to Supabase. If either is missing,
# it gracefully falls back to localStorage on the user's device.
# Run supabase/schema.sql in your Supabase project first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenAI (optional) -----------------------------------------------------
# If set, /api/generate uses AI to draft the readiness profile (with safety
# guardrails). If unset OR if the call fails, the rule-based generator is used.
OPENAI_API_KEY=
# Optional model override (defaults to gpt-4o-mini)
OPENAI_MODEL=

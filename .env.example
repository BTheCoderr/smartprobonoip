# SmartProBono unified platform environment variables
# Everything here is OPTIONAL unless noted for pilot/production.
# With no variables set, the app runs end-to-end using localStorage + rule-based generation.

# --- Supabase (optional for local demo; required for pilot persistence) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for pilot/account persistence with tightened RLS.
# Preferred for hosted Supabase projects: the current sb_secret_... key.
# Legacy service_role JWT remains supported as a temporary fallback.
# NEVER expose either key as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth magic links support both SmartProBono platform accounts and
# organization-member accounts. Anonymous IP pilot sessions still work, but a
# signed-in user can link that browser session to their SmartProBono account.
# Configure both redirect URLs in Supabase Auth:
#   {NEXT_PUBLIC_APP_URL}/api/auth/callback
#   {NEXT_PUBLIC_APP_URL}/api/organization/auth/callback

# --- Partner dashboard (pilot) ---------------------------------------------
# Protects /api/partner/* routes. Partners enter this on the dashboard page.
PARTNER_DASHBOARD_SECRET=

# --- AI providers (optional by feature) -------------------------------------
# SmartProBonoIP readiness / coach
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# SmartProBono Legal / Ermi
# Optional dedicated provider. If unset, Legal reuses OPENAI_API_KEY above.
# Server-only.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Deploy ----------------------------------------------------------------
# Canonical URL for links in exports (optional)
NEXT_PUBLIC_APP_URL=https://smartprobono.org

# --- Google Tag Manager (optional) -------------------------------------------
# Public marketing analytics only. Disabled when unset.
# Configure GA4 measurement ID G-Q2MD6ESG15 inside the GTM container — not here.
NEXT_PUBLIC_GTM_ID=

# --- Interest form notifications (optional) ----------------------------------
# Uses same Resend sender as recovery when set.
INTEREST_NOTIFY_EMAIL=
# RESEND_API_KEY=
# RECOVERY_FROM_EMAIL=

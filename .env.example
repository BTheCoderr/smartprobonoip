# SmartProBonoIP environment variables
# Everything here is OPTIONAL unless noted for pilot/production.
# With no variables set, the app runs end-to-end using localStorage + rule-based generation.

# --- Supabase (optional for local demo; required for pilot persistence) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for pilot when using tightened RLS (API routes).
# NEVER expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Partner dashboard (pilot) ---------------------------------------------
# Protects /api/partner/* routes. Partners enter this on the dashboard page.
PARTNER_DASHBOARD_SECRET=

# --- OpenAI (optional) -----------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Deploy ----------------------------------------------------------------
# Canonical URL for links in exports (optional)
NEXT_PUBLIC_APP_URL=https://smartprobonoip.netlify.app

# --- Google Tag Manager (optional) -------------------------------------------
# Public marketing analytics only. Disabled when unset.
# Configure GA4 measurement ID G-Q2MD6ESG15 inside the GTM container — not here.
NEXT_PUBLIC_GTM_ID=

# --- Interest form notifications (optional) ----------------------------------
# Uses same Resend sender as recovery when set.
INTEREST_NOTIFY_EMAIL=
